// clang-format off
typedef void (*func_ptr)();

// PCINT VARIANT
volatile func_ptr current_user_func{nullptr};
volatile uint8_t current_interrupt_mode{};
volatile uint8_t current_pin{};

volatile func_ptr callbacks[20] = {nullptr};
volatile uint8_t modes[20] = {0};

template <uint8_t PIN, func_ptr USERFUNC, uint8_t INT_MODE>
void attachInterrupt() 
{
    current_user_func = USERFUNC;
    current_interrupt_mode = INT_MODE;
    current_pin = PIN;

    if (PIN <= 7) {                      // pin 0 - 7 are D (group2)
        PCICR |= (1 << PCIE2);           // activate ISR for group 0
        PCMSK2 |= (1 << PIN);            // this lets the pin fire the ISR
    } else if (PIN >= 8 && PIN <= 13) {  // pin 8 - 13 are B (group0)
        PCICR |= (1 << PCIE0);           // the rest is the same just make sure
        PCMSK0 |= (1 << (PIN - 8));      // to always change the nums of the registers
    } else if (PIN >= 14 && PIN <= 19) { // pin 14 - 19 are C (group1)
        PCICR |= (1 << PCIE1);           //
        PCMSK1 |= (1 << (PIN - 14));     //
    }
};

ISR(PCINT0_vect) {
    if (current_interrupt_mode == RISING)
        if (digitalRead(current_pin) == 1) {
