bool digitalRead(uint8_t pin)
{
    uint8_t bit{};
    if (pin <= 7) // if pin is 0 - 8 we use port D
    {
        bit = pin;

        if (PIND & (1 << bit)) // if the bit is one i jsut return true (1)
            return true;       // else i return false (0)
        else                   // the bool thing is optional but i think its nicer
            return false;      // to write 'if (digitalRead(pin))...' instead of 'if (digitalRead(pin) == HIGH)...'
    }
    else if (pin <= 13 and pin >= 8) // if pin is 8 - 13 we use port B
    {
        bit = pin - 8;

        if (PINB & (1 << bit))
            return true;
        else 
            return false;
    }
    else if (pin <= 19 and pin >= 14) // if pin is 14 - 19 we use port C
    {
        bit = pin - 14;

        if (PINC & (1 << bit))
            return true;
        else 
            return false;
    }
}
