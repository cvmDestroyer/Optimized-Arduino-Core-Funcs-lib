#define REGISTER (*(volatile uint8_t *)(0xFF)) // this shouldnt exsist just so nothing breaks
#define BIT0 0                                 // this btw just so if someone selects C++
#define BIT1 1                                 // in their editor as language it get correct syntax

bool what_is_bit_0()
{
    REGISTER |= (1 << BIT0);  // this is how to set a bit to 1
    REGISTER &= ~(1 << BIT0); // this is how to set a bit to 0 i looks wrong because of 1 << BIT0
    //                           but it isnt it doesnt work with 0 << BIT0
    // if more bits should be set to 1 or 0 this is how
    REGISTER |= (1 << BIT0) | (1 << BIT1);    // if you want to set bit0 and bit1 to 1
    REGISTER = (1 << BIT0) | (1 << BIT1);     // if you want to delete all bits and want to set bit0 and bit1 to 1
    REGISTER &= ~((1 << BIT0) | (1 << BIT1)); // if you want to set bit0 and bit1 to 0
    // if you want to inspect bits
    REGISTER & (1 << BIT0);     // you can put it in a if statement if the bit is 1 the statement is true
    if (REGISTER & (1 << BIT0)) // this is to see if the bit is 1
        return 1;
    if (!(REGISTER & (1 << BIT0))) // this if you want to see if its 0
        return 0;
    /*
      here is what each chackter does
      OR  operator '|' sets to 1 as long as one or two bits are 1
      AND operator '&' sets to 1 if both bits are 1 else 0
      NOT operator '~' sets every bit to its counter part so 1 -> 0, 0 -> 1
      XOR operator '^' sets to 1 if the compared bits are diffrent else 0
    */
}
