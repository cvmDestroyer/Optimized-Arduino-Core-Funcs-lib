void pinMode(uint8_t pin, uint8_t mode)
{
    uint8_t oldSREG{SREG};
    cli();
    uint8_t bit{};

    if (pin <= 7 && pin >= 0) 
    {
        if (mode == OUTPUT)
        {
            bit = pin;
            DDRD |= (1 << bit);
            PORTD &= ~(1 << bit);
        } 
        else if (mode == INPUT)
        {
            DDRD &= ~(1 << pin);  
            PORTD &= ~(1 << pin);
        } 
        else if (mode == INPUT_PULLUP) 
        {
            DDRD &= ~(1 << pin);
            PORTD |= (1 << pin);
        }
    }
    else if (pin <= 13 && pin >= 8) 
    {
        bit = pin - 8;
        if (mode == OUTPUT) 
        {
            DDRB |= (1 << bit);
            PORTB &= ~(1 << bit);
        } 
        else if (mode == INPUT) {
            DDRB &= ~(1 << bit);
            PORTB &= ~(1 << bit);
        } 
        else if (mode == INPUT_PULLUP) 
        {
            DDRB &= ~(1 << bit);
            PORTB |= (1 << bit);
        }
    }
    else if (pin <= 14 && pin >= 8) 
    {
        bit = pin - 14;
        if (mode == OUTPUT) 
        {
            DDRC |= (1 << bit);
            PORTC &= ~(1 << bit);
        } 
        else if (mode == INPUT) 
        {
            DDRC &= ~(1 << bit);
            PORTC &= ~(1 << bit);
        } 
        else if (mode == INPUT_PULLUP) 
        {
            DDRC &= ~(1 << bit);
            PORTC |= (1 << bit);
        }
    }

    SREG = oldSREG;
}
