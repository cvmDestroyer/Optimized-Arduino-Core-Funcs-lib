/*                                                                                                                
  okay that took a while but hopefuly now you know how to count in binary its an important skill better             
  learn it now than never now we can focus on a nother register called Digital Input Disable Register 0
  or DIDR0 for short the whole thing it does deactivate the digital input function (as in the name descriped)
  to reduse noise while measuring ADC it works like PORT or PIN you just change the pin with the corosponding bit
  bit 6 and 7 ARE NOT beeing used not even by for example nano because those are reserved remeber the nano analog
  pin A6 and A7 are analog ONLY pins unlike A0 - A5 where digitalRead still works
  bit set to 1 deactivates these digitalRead functions for digitalRead on analog pins the corosponding bit in
  DIDR has to be set to 0
*/
void example() 
{
    DIDR0 |= (1 << 1); // turn off digital input on pin A1
    DIDR0 &= ~(1 << 0); // turn on digital input on pin A0
}
namespace analogUno {
/*
  next up
  ADC Control and Status Register A                  
  or ADCSRA for short it enables ADC (the register that gives us our values to return) and start ADC                
  the last thing it does is select the prescaler for the ADC in other words how fast the ADC goes all              
  the makros for bits are down below in another tabel:                                                              
  .                                                                                                                 
  PRESCALER BITS                                                                                                    
  .  ADPS2  |  ADPS1  |  ADPS0  |  ADC-clock  |  prescaler  |  rating                                           
  .---------|---------|---------|-------------|-------------|------------------------------------------
  .    0    |    0    |    0    |    8 MHz    |      2      |   WAY to fast                                      
  .    0    |    0    |    1    |    8 MHz    |      2      |   WAY to fast                                      
  .    0    |    1    |    0    |    4 MHz    |      4      |   to fast                                          
  .    0    |    1    |    1    |    2 MHz    |      8      |   to fast                                          
  .    1    |    0    |    0    |    1 MHz    |      16     |   very fast but loses accuracy              
  .    1    |    0    |    1    |   500 kHz   |      32     |   still fast but less accuracy gets lost           
  .    1    |    1    |    0    |   250 kHz   |      64     |   nice balance between accuracy and speed          
  .    1    |    1    |    1    |   125 kHz   |     128     |   standard with optimal accuracy                   
  .                                                                                                                 
  Other useful macros are ADC ENable or ADEN for shoert as the name implies this needs to be set to 1               
  or the whole ADC thing does not work                                                                              
  .                                                                                                                 
  to sart the ADC you use the bit ADSC (ADC Start Conversion) this bit will automaticly be set to 0 after             
  the ADC is done with the result of the measurement                                                                
  to get the ADC value just type 'return ADC;' or store in a variable depens on what you want to do with it
  something to note the result of ADC is measured in 10-bit so the value range is 0 - 1023
                                                                                                                 
  now you have every thing you need to know and we can start the analogRead coding part                             
  again i encourage you to try is your self if your done down below is my version:                                  
*/
uint16_t analogRead(uint8_t pin)
{
    uint8_t oldSREG{SREG};
    cli();

    if (pin <= 13 && pin >= 19) // if it isnt a analog pin
        return 0;               // return 0

    ADMUX = (1 << REFS0) | (pin - 14); // turn on default refrence and the MUX
    DIDR0 |= (1 << (pin - 14));        // turn off digital input
    // precaler of 128 but of course you can use a faster one and enable ADC
    ADCSRA = (1 << ADEN) | (1 << ADPS2) | (1 << ADPS2) | (1 << ADPS2);
    
    ADCSRA |= (1 << ADSC); // start ADC

    while (ADCSRA & (1 << ADSC)) // if ADC is done ADSC filps to 0 remember?
        ; // null statement
    
    DIDR0 &= ~(1 << (pin - 14)); // so the user is still able to use digitalRead
    // ADCSRA &=  ~(1 << ADEN);  // dont disable ADC if you do your function wont work because
    //                              ADC takes some time to deliver correct values and if you turn it off the next 
    //                              analogRead will not deliver correct values
    SREG = oldSREG;
    return ADC;                  // and finaly return the result
}

/*
  Okay that was the analogRead part now we come to analogWrite even tho its called analog
  is isnt analog and only works on pwm pins (digital pin) they are marked as '~' on your board
  but its alittle bit weird because you have to use some timer registers but why you may ask
  well first of all we have to clarifie how we simulate something 'analog' remember the pins 
  with ~ arent real analog pins but just pwm pins. we cant give the pin 'less' power but we
  can turn them on and off realy quick. there is a catch tho as you might have noticed not every
  pin has pwm and thats because pwm pins are directly connected to timers on the Arduino Uno there
  are only 3 timers and we can house 2 pins per timer therefore the max pwm pins are 6 pins
  here are they all listet and their timers:
  .            pin 5 and pin 6  on timer 0 (8bit)
  .            pin 9 and pin 10 on timer 1 (16bit)
  .            pin 3 amd pin 11 on timer 2 (8bit)
  .
  so i wont go in to much detail if you want more details take a look in ther timerUno file.
  there is one control register per timer which lets you control the modes for analogWrite (we
  just use fast PWM 8bit) and it lets you connect the hardwear timer with pin. the register is
  called TCCRxA. the WGMx2, WGMx1, WGMx0 bits are the bits which control the mode. there is
  something to be aware tho and that is that WGMx2 IS NOT in TCCRxA but in TCCRxB because
  there was to little space in TCCRxA if you want a tabel with all WGMxx bits take look in
  timerUno
  for now just type this to activate fast PWM 8bit on timer2 and timer0:
  .       TCCRxA = (1 << WGMx1) | (1 << WGMx0);  // activate fast PWM 8bit on 8bit timer2 and timer0
  .       TCCRxA |= (1 << COMxx1);               // connect timer with pin
  . 
  for now just type this to activate fast PWM 8nit on timer1:
  .       TCCR1A = (1 << WGM10);                 // activate fast PWM 8bit on 16bit timer1
  .       TCCR1B |= (1 << WGM12);                // this is needed for fast PWM else it would be PWM, phase correct (8bit)
  .       TCCR1A |= (1 << COM1x1);               // connect timer with pin 

  the last step is to use a prescaler just like in analogRead but this time the bits are called diffrent
  CSx2, CSx1, CSx0 and are for the TCCRxB register if you want a tabel for every combination look in the
  timerUno file for now just type this:
  for timer2
  .       TCCR2B |= (1 << CS22); // prescaler of 64
  .
  for timer1 and timer0
  .       TCCRxB |= (1 << CSx1) | 1 << CSx0); // prescaler of 64
  .
  the last step is to give OCRxA and OCRxB the values you want the pin
  run on (your value from analorWrite(pin, VALUE);)
  okay i dont want you to figure out your self which pin is in which timer and which COMxx1 to use so here
  is a small tabel with all you need to know to write your own analogWrite :
  .        
  .    pin | COMxx1 | OCRxx | TCCRxA | TCCRxB | CSx2 | CSx1 | CSx0 | WGMx2(TCCRxB) | WGMx1(TCCRxA) | WGMx0(TCCRxA) 
  .  ------|--------|-------|--------|--------|------|------|------|---------------|---------------|---------------  
  .     3  | COM2B1 | OCR2B | TCCR2A | TCCR2B | CS22 |  ~~  |  ~~  |       ~       |     WGM21     |     WGM20     
  .     5  | COM0B1 | OCR0B | TCCR0A | TCCR0B |  ~~  | CS01 | CS00 |       ~       |     WGM01     |     WGM00     
  .     6  | COM0A1 | OCR0A | TCCR0A | TCCR0B |  ~~  | CS01 | CS00 |       ~       |     WGM01     |     WGM00     
  .     9  | COM1A1 | OCR1A | TCCR1A | TCCR1B |  ~~  | CS11 | CS10 |     WGM12     |       ~       |     WGM10     
  .    10  | COM1B1 | OCR1B | TCCR1A | TCCR1B |  ~~  | CS11 | CS10 |     WGM12     |       ~       |     WGM10     
  .    11  | COM2A1 | OCR2A | TCCR2A | TCCR2B | CS22 |  ~~  |  ~~  |       ~       |     WGM21     |     WGM20     
*/
void analogWrite(uint8_t pin, uint8_t val)
{
    uint8_t oldSREG{SREG};
    cli();

    switch (pin) // okay as you may notice all pins have diffrent Makros 
    {            // but a long if statement is ugly thats why we just use switch for each pin
    case 3:      // timer 2
        if (val == 0) {               // if val is 0
            TCCR2A &= ~(1 << COM2B1); // disconnect timer with pin
            PORTD &= ~(1 << PD3);     // and digitalWrite(3, LOW);
        } else if (val == 255) {      // if val is 255
            TCCR2A &= ~(1 << COM2B1); // disconnect timer with pin
            PORTD |= (1 << PD3);      // and digitalWrite(3, HIGH);
        } else {
            TCCR2A = (1 << WGM21) | (1 << WGM20) | (1 << COM2B1); // turn on fast PWM + connect pin with timer
            TCCR2B = (1 << CS22); // prescaler of 64
            OCR2B = val; // give OCR2B the val it does the rest
        }
        break;

    case 5:    // timer 0
        if (val == 0) {               // if val is 0
            TCCR0A &= ~(1 << COM0B1); // disconnect timer with pin
            PORTD &= ~(1 << PD5);     // and digitalWrite(5, LOW);
        } else if (val == 255) {      // if val is 255
            TCCR0A &= ~(1 << COM0B1); // disconnect timer with pin
            PORTD |= (1 << PD5);      // and digitalWrite(5, HIGH);
        } else {
            TCCR0A = (1 << WGM01) | (1 << WGM00) | (1 << COM0B1); // turn on fast PWM + connect pin with timer
            TCCR0B = (1 << CS01) | (1 << CS00); // prescaler of 64 (remeber timer 2 is difrent than timer0 and timer1)
            OCR0B = val; // give OCR0B the val it does the rest
        }
        break;

    case 9:    // timer 1
        if (val == 0) {               // if val is 0
            TCCR1A &= ~(1 << COM1A1); // disconnect timer with pin
            PORTB &= ~(1 << PB1);     // and digitalWrite(9, LOW);
        } else if (val == 255) {      // if val is 255
            TCCR1A &= ~(1 << COM1A1); // disconnect timer with pin
            PORTB |= (1 << PB1);      // and digitalWrite(9, HIGH);
        } else {
            TCCR1A = (1 << WGM10) | (1 << COM1A1); // turn on PWM, phase correct (8bit) + connect pin with timer
            TCCR1B = (1 << CS11) | (1 << CS10) | (1 << WGM12); // prescaler of 64 + flip bit WGM12 t o1 so it runs on fast PWM (8bit) not PWM, phase correct (8bit)
            OCR1A = val; // give OCR1A the val it does the rest
        }
        break;
    
    default:
        digitalWrite(pin, (val >= 128) ? HIGH : LOW);
        break;
    }
    SREG = oldSREG;
}
